APP_NAME=KoreaFood
APP_ENV=production
APP_KEY=base64:MgzscReH6nu6sSujMQlRaEnu/2cA1Ugsy1MIlj00WTU=
APP_DEBUG=true
APP_URL=https://api.koreafood.net

# Logging
# Local: LOG_CHANNEL=stack, LOG_LEVEL=debug
# Production: LOG_CHANNEL=production, LOG_LEVEL=warning (hoặc error)
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK_CHANNELS=single
LOG_DAILY_DAYS=14
LOG_ERROR_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=foodshop_db
DB_USERNAME=foodshop_user
DB_PASSWORD=foodshop_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# JWT (tymon/jwt-auth) - run: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cloudinary - upload ảnh lên cloud (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Imgur - upload ảnh (đăng ký tại https://api.imgur.com/oauth2/addclient)
IMGUR_CLIENT_ID=

# Chọn provider upload ảnh: cloudinary | imgur (mặc định: cloudinary)
IMAGE_UPLOAD_DRIVER=cloudinary

# Kích thước tối đa mỗi ảnh input (MB). Mặc định: 2
IMAGE_MAX_SIZE_MB=2

# Dung lượng mục tiêu sau khi nén (KB). Ảnh sẽ được resize+nén về ~200-500KB. Mặc định: 500
IMAGE_TARGET_MAX_KB=500
